{
  "id": "volcano",
  "name": "Volcano Activity",
  "version": "0.2.0",
  "description": "Display current volcanic eruption alerts from the Smithsonian Global Volcanism Program weekly report.",
  "author": "FiestaBoard Team",
  "icon": "mountain",
  "category": "data",
  "repository": "https://github.com/Fiestaboard/fiestaboard-plugin--volcano",
  "documentation": "README.md",
  "min_refresh_seconds": 3600,
  "settings_schema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "title": "Enabled",
        "default": false
      },
      "refresh_seconds": {
        "type": "integer",
        "title": "Refresh Interval (seconds)",
        "description": "How often to check for eruption updates.",
        "default": 3600,
        "minimum": 1800
      }
    },
    "required": []
  },
  "variables": {
    "groups": {
      "latest": {
        "label": "Latest Activity"
      },
      "stats": {
        "label": "Statistics"
      }
    },
    "simple": {
      "volcano_name": {
        "description": "Volcano at the top of this week's report; the GVP lists new activity before ongoing activity",
        "type": "string",
        "max_length": 22,
        "group": "latest",
        "example": "Kilauea"
      },
      "country": {
        "description": "Country that volcano is in",
        "type": "string",
        "max_length": 20,
        "group": "latest",
        "example": "United States"
      },
      "activity": {
        "description": "Activity status from the report, shortened to fit a board line",
        "type": "string",
        "max_length": 22,
        "group": "latest",
        "example": "Ongoing Eruption"
      },
      "active_count": {
        "description": "Number of volcanoes listed as active this week",
        "type": "integer",
        "max_length": 3,
        "group": "stats",
        "example": "12"
      }
    }
  },
  "screenshots": [
    {
      "src": "docs/board-display.png",
      "alt": "Volcano Activity displayed on a Vestaboard",
      "caption": "Example board output using the default template",
      "primary": true
    }
  ],
  "teaser": "KILAUEA ERUPTS",
  "previews": [
    {
      "device_type": "flagship",
      "rows": [
        "   Volcano Activity",
        "",
        "       Kilauea",
        "    United States",
        "   Ongoing Eruption",
        " 12 volcanoes active"
      ]
    },
    {
      "device_type": "note",
      "rows": [
        "{63}{64} VOLCANO",
        "KILAUEA",
        "{63}ERUPTING"
      ]
    }
  ],
  "api_docs": "https://volcano.si.edu/",
  "demo": {
    "flagship": {
      "name": "Volcano Activity Demo",
      "config": {
        "enabled": true,
        "refresh_seconds": 3600
      },
      "template": [
        "Volcano Activity",
        "",
        "{{volcano.volcano_name}}",
        "{{volcano.country}}",
        "{{volcano.activity}}",
        "{{volcano.active_count}} volcanoes active"
      ],
      "line_metadata": [
        {
          "alignment": "center",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "center",
          "wrap": false
        },
        {
          "alignment": "center",
          "wrap": false
        },
        {
          "alignment": "center",
          "wrap": false
        },
        {
          "alignment": "center",
          "wrap": false
        }
      ]
    },
    "note": {
      "name": "Volcano Activity (Note)",
      "template": [
        "VOLCANO",
        "{{volcano.volcano_name}}",
        "{{volcano.activity}}"
      ],
      "line_metadata": [
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": true
        },
        {
          "alignment": "left",
          "wrap": false
        }
      ]
    }
  }
}
